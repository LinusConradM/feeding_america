---
import Base from "../layouts/Base.astro";
import Fig from "../components/Fig.astro";
import Source from "../components/Source.astro";
import { national, usdaSrc, mmgYearSource, counties } from "../lib/data";
import { millions, num, pts } from "../lib/format";
const n = national as any;
const rows = n.rows as any[];
const last = rows[rows.length - 1];
const ch = n.change;
const cyear = (counties as any).county_year;
const rates = Object.fromEntries(Object.entries<any>((counties as any).counties).map(([f, r]) => [f, r[2]]));
const t1a = usdaSrc("Table 1A and the ERS chart data file. Households: share of all US households. People: everyone living in a food-insecure household, as a share of all people.");
const tch = usdaSrc("ERS chart data file, children by food security status of household.");
const changeText = ch.significant
  ? `a statistically significant change of ${ch.change_pts > 0 ? "+" : ""}${ch.change_pts} points from ${ch.from}`
  : `not statistically different from ${ch.from} (${ch.change_pts > 0 ? "+" : ""}${ch.change_pts} points; USDA test at 90% confidence)`;
---
<Base title="National" page="national" description="US household food insecurity, 2001 to 2024, from USDA's final Household Food Security report.">
  <div class="hero">
    <div>
      <div class="kicker"><span>United States</span><span>·</span><span>{last.year} data</span><span>·</span><span class="hot">Final year of USDA's survey</span></div>
      <h1 style="margin-top:18px">{millions(last.ppl_k)} million<span>people lived in food-insecure households in {last.year}.</span></h1>
    </div>
    <aside>
      <p>That is {pts(last.ppl_pct)} of all people, including {millions(last.ch_k)} million children. By households, {pts(last.hh_pct)} were food insecure, {changeText}. USDA ended the survey behind these figures in 2025, so no later count will follow.</p>
      <Source s={t1a} />
    </aside>
  </div>

  <figure class="bigmap" style="margin:0">
    <a href={`${import.meta.env.BASE_URL}counties/`} aria-label={`County map of the share of people food insecure in ${cyear}. Open the Counties page to explore it.`}><div id="nat-map" role="img" aria-label={`County map of the share of people food insecure, ${cyear}. Every county's value is listed on the Counties page.`}></div></a>
    <figcaption>
      <span class="cap">Share of people food insecure, by county, {cyear}</span>
      <span class="ramp"><span>Under 10%</span><i style="background:var(--q1)"></i><i style="background:var(--q2)"></i><i style="background:var(--q3)"></i><i style="background:var(--q4)"></i><i style="background:var(--q5)"></i><i style="background:var(--q6)"></i><span>20% or more</span></span>
      <span class="note" style="width:100%">Modeled estimates. Feeding America publishes no county intervals, so neighboring shades may not differ meaningfully. <a class="more-link" href={`${import.meta.env.BASE_URL}counties/`}>Explore every county</a></span>
      <span style="width:100%"><Source s={mmgYearSource(cyear)} /></span>
    </figcaption>
  </figure>

  <div class="figs">
    <Fig k={`Households food insecure, ${last.year}`} v={last.hh_pct.toFixed(1)} small="%" unit="of households" ci={`${millions(last.hh_k)} million of ${millions(last.hh_total_k)} million households`} src={t1a} />
    <Fig k={`People in food-insecure households, ${last.year}`} v={millions(last.ppl_k)} small=" million" unit="people" ci={`${pts(last.ppl_pct)} of people`} src={t1a} />
    <Fig k={`Children in food-insecure households, ${last.year}`} v={millions(last.ch_k)} small=" million" unit="children" ci={`${pts(last.ch_pct)} of children`} src={tch} />
    <Fig k="2025 and later" v="None" unit="no estimate" ci="USDA ended the Food Security Supplement, so no 2025 figure will be published." />
  </div>

  <div class="card">
    <div class="card-head">
      <div class="t"><h2 id="nat-title">Share of households that were food insecure</h2><span class="note">2001 to {last.year}, one value per year</span></div>
      <div class="controls">
        <div class="seg" role="group" aria-label="Who is counted"><button data-g="hh" aria-pressed="true">Households</button><button data-g="ppl" aria-pressed="false">People</button><button data-g="ch" aria-pressed="false">Children</button></div>
        <div class="seg" role="group" aria-label="Measure"><button data-m="pct" aria-pressed="true">Share</button><button data-m="k" aria-pressed="false">Number</button></div>
      </div>
    </div>
    <div id="nat-chart" class="chart" role="img" aria-label="Line chart of the national food insecurity series. The same values are in the table below."></div>
    <p class="note">Households and people are two views of the same survey: a person is counted when the household they live in is food insecure. USDA publishes no standard errors for this national table, so no interval is drawn. People and children are counts of everyone living in a food-insecure household, not of people who were each individually food insecure.</p>
    <Source s={t1a} />
    <details class="alt"><summary>Show the data as a table</summary>
      <div class="tablewrap"><table>
        <caption class="sr">National food insecurity by year, USDA ERR-358</caption>
        <thead><tr><th scope="col">Year</th><th scope="col">% of households</th><th scope="col">Households (000s)</th><th scope="col">% of people</th><th scope="col">People (000s)</th><th scope="col">% of children</th><th scope="col">Children (000s)</th></tr></thead>
        <tbody>{[...rows].reverse().map((r) => <tr><th scope="row">{r.year}</th><td>{pts(r.hh_pct)}</td><td>{num(r.hh_k)}</td><td>{pts(r.ppl_pct)}</td><td>{num(r.ppl_k)}</td><td>{pts(r.ch_pct)}</td><td>{num(r.ch_k)}</td></tr>)}</tbody>
      </table></div>
    </details>
  </div>

  <div class="card">
    <h2>Why the national figure comes from USDA</h2>
    <p class="note">USDA's figures are direct survey estimates. Map the Meal Gap, which this site uses for states and counties, is a model calibrated to the same survey. It reports people, not households, and its state figures are built up from congressional districts, so its totals differ from USDA's {millions(last.ppl_k)} million. This site does not add Map the Meal Gap figures up to a national total, and it labels every rate as a share of households or a share of people.</p>
    <Source s={mmgYearSource((counties as any).county_year)} />
  </div>
  <script type="application/json" id="d-nat" set:html={JSON.stringify(rows)}></script>
  <script type="application/json" id="d-rates" set:html={JSON.stringify({ rates, base: import.meta.env.BASE_URL })}></script>
</Base>

<script>
  import { chart, base, axis, css, onTheme, readJSON } from "../lib/charts";
  import { drawCountyMap } from "../lib/countymap";
  const rows = readJSON<any[]>("d-nat");
  const R = readJSON<any>("d-rates");
  drawCountyMap(document.getElementById("nat-map")!, R.rates, R.base);
  let g = "hh", m = "pct";
  const LABEL: Record<string, string> = { hh: "households", ppl: "people", ch: "children" };
  function render() {
    const isPct = m === "pct";
    const key = `${g}_${m}`;
    document.getElementById("nat-title")!.textContent =
      (isPct ? "Share of " : "Number of ") + (g === "hh" ? "households that were food insecure" : `${LABEL[g]} living in food-insecure households`);
    const col = g === "ch" ? css("--child") : css("--accent");
    const data = rows.filter((r) => r.year >= 2001 && r[key] != null).map((r) => [r.year, isPct ? r[key] : r[key] / 1000]);
    const fmt = (v: number) => (isPct ? v.toFixed(1) + "% of " + LABEL[g] : v.toFixed(1) + " million " + LABEL[g]);
    chart("nat-chart").setOption({
      ...base(),
      grid: { left: 44, right: 56, top: 24, bottom: 28 },
      xAxis: { type: "value", min: 2001, max: rows[rows.length - 1].year, interval: 4, ...axis(), splitLine: { show: false }, axisLabel: { color: css("--muted"), fontSize: 12, formatter: (v: number) => String(v) } },
      yAxis: { type: "value", min: 0, ...axis(), axisLabel: { color: css("--muted"), fontSize: 12, formatter: (v: number) => (isPct ? v + "%" : v + "M") } },
      tooltip: { ...base().tooltip, valueFormatter: fmt },
      series: [{
        type: "line", data, symbol: "circle", symbolSize: 5, lineStyle: { width: 2.5, color: col }, itemStyle: { color: col }, areaStyle: { color: css("--area"), opacity: 0.35 },
        markLine: { symbol: "none", silent: true, label: { color: css("--muted"), fontSize: 11, formatter: (p: any) => p.name, position: "insideEndTop" }, lineStyle: { color: css("--border"), type: "dashed" },
          data: [{ xAxis: 2008, name: "2008 recession" }] },
        endLabel: { show: true, color: css("--fg"), fontWeight: 600, formatter: (p: any) => (isPct ? p.value[1].toFixed(1) + "%" : p.value[1].toFixed(1) + "M") },
      }],
    });
  }
  document.querySelectorAll<HTMLButtonElement>(".seg button").forEach((b) =>
    b.addEventListener("click", () => {
      if (b.dataset.g) g = b.dataset.g;
      if (b.dataset.m) m = b.dataset.m;
      b.parentElement!.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      render();
    }),
  );
  onTheme(render);
  render();
</script>
